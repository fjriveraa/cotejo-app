{
  "rewrites": [
    {
      "source": "/g/:code",
      "destination": "/api/og?code=:code"
    },
    {
      "source": "/g/:code/:member",
      "destination": "/api/og?code=:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}